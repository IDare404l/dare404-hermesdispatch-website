---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const password = url.searchParams.get('password') || '';
const runtime = (Astro.locals as any)?.runtime;
const adminToken = runtime?.env?.ADMIN_TOKEN || '';
const isAuthed = password === adminToken;

const title = "Affiliate Click Analytics | Hermes Dispatch";
const description = "Internal dashboard for tracking outbound affiliate and referral link clicks.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="relative py-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-brand-dark to-brand-accent/10"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4">
      <h1 class="text-3xl font-bold mb-2">Click Analytics</h1>
      <p class="text-gray-400 mb-8">Track outbound affiliate and referral link performance.</p>

      {!isAuthed ? (
        <form method="GET" class="max-w-md bg-neutral-900 border border-neutral-800 rounded-xl p-6">
          <label class="block text-sm text-gray-400 mb-2">Admin password</label>
          <input type="password" name="password" class="w-full px-4 py-2 rounded-lg bg-neutral-950 border border-neutral-700 text-white mb-4" autofocus />
          <button type="submit" class="btn-primary w-full">View Dashboard</button>
        </form>
      ) : (
        <div id="dashboard" data-password={password}>
          <div class="flex gap-4 mb-6">
            <button class="days-btn px-4 py-2 rounded-lg bg-neutral-900 border border-neutral-700 text-gray-300 hover:border-cyan-400" data-days="7">7 days</button>
            <button class="days-btn px-4 py-2 rounded-lg bg-neutral-900 border border-neutral-700 text-gray-300 hover:border-cyan-400" data-days="30">30 days</button>
            <button class="days-btn px-4 py-2 rounded-lg bg-neutral-900 border border-neutral-700 text-gray-300 hover:border-cyan-400" data-days="90">90 days</button>
          </div>

          <div class="grid md:grid-cols-3 gap-4 mb-8">
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
              <p class="text-sm text-gray-400">Total Clicks</p>
              <p class="text-3xl font-bold text-brand-accent" id="total-clicks">—</p>
            </div>
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
              <p class="text-sm text-gray-400">Top Slug</p>
              <p class="text-xl font-bold text-brand-gold" id="top-slug">—</p>
            </div>
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
              <p class="text-sm text-gray-400">Tracked Sources</p>
              <p class="text-xl font-bold text-purple-400" id="source-count">—</p>
            </div>
          </div>

          <h2 class="text-xl font-bold mb-4">Clicks by Affiliate/Link Slug</h2>
          <div class="bg-neutral-900 border border-neutral-800 rounded-xl overflow-hidden mb-8">
            <table class="w-full text-sm">
              <thead class="bg-white/5 border-b border-white/10">
                <tr>
                  <th class="text-left p-4 font-semibold">Slug</th>
                  <th class="text-right p-4 font-semibold">Clicks</th>
                  <th class="text-right p-4 font-semibold">Share</th>
                </tr>
              </thead>
              <tbody id="slug-table">
                <tr><td colspan="3" class="p-8 text-center text-gray-500">Loading...</td></tr>
              </tbody>
            </table>
          </div>

          <h2 class="text-xl font-bold mb-4">Clicks by Day</h2>
          <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-4 overflow-x-auto">
            <div id="day-chart" class="flex items-end gap-2 h-40 min-w-max"></div>
          </div>
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    (function() {
      const dashboard = document.getElementById('dashboard');
      if (!dashboard) return;
      const password = dashboard.dataset.password;

      async function load(days) {
        const res = await fetch(`/api/click-stats/?days=${days}&password=${encodeURIComponent(password)}`);
        if (!res.ok) {
          document.getElementById('slug-table').innerHTML = `<tr><td colspan="3" class="p-8 text-center text-red-400">Failed to load data (${res.status})</td></tr>`;
          return;
        }
        const data = await res.json();

        document.getElementById('total-clicks').textContent = data.total.toLocaleString();
        const topSlug = Object.entries(data.clicks_by_slug)[0];
        document.getElementById('top-slug').textContent = topSlug ? topSlug[0] : 'None';
        document.getElementById('source-count').textContent = Object.keys(data.sources || {}).length.toString();

        const tbody = document.getElementById('slug-table');
        const entries = Object.entries(data.clicks_by_slug || {});
        if (entries.length === 0) {
          tbody.innerHTML = `<tr><td colspan="3" class="p-8 text-center text-gray-500">No clicks tracked yet.</td></tr>`;
        } else {
          tbody.innerHTML = entries.map(([slug, count]) => {
            const share = data.total ? ((count / data.total) * 100).toFixed(1) : '0.0';
            return `<tr class="border-b border-white/5 hover:bg-white/[0.02]">
              <td class="p-4 font-mono text-sm">${slug}</td>
              <td class="p-4 text-right font-semibold">${count.toLocaleString()}</td>
              <td class="p-4 text-right text-gray-400">${share}%</td>
            </tr>`;
          }).join('');
        }

        const chart = document.getElementById('day-chart');
        const dayEntries = Object.entries(data.clicks_by_day || {}).sort();
        if (dayEntries.length === 0) {
          chart.innerHTML = `<div class="w-full text-center text-gray-500 self-center">No daily data.</div>`;
        } else {
          const max = Math.max(...dayEntries.map(e => Object.values(e[1]).reduce((a, b) => a + b, 0)), 1);
          chart.innerHTML = dayEntries.map(([date, slugs]) => {
            const dayTotal = Object.values(slugs).reduce((a, b) => a + b, 0);
            const height = (dayTotal / max) * 100;
            return `<div class="flex flex-col items-center gap-1 group min-w-[2.5rem]">
              <div class="w-full bg-brand-accent/60 hover:bg-brand-accent rounded-t transition-all relative" style="height:${height}px">
                <span class="absolute -top-6 left-1/2 -translate-x-1/2 text-xs text-gray-300 opacity-0 group-hover:opacity-100 whitespace-nowrap">${dayTotal}</span>
              </div>
              <span class="text-[10px] text-gray-500">${date.slice(5)}</span>
            </div>`;
          }).join('');
        }
      }

      document.querySelectorAll('.days-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.days-btn').forEach(b => b.classList.remove('border-cyan-400', 'text-cyan-400'));
          btn.classList.add('border-cyan-400', 'text-cyan-400');
          load(btn.dataset.days);
        });
      });

      // Load 7 days by default
      document.querySelector('.days-btn[data-days="7"]').click();
    })();
  </script>
</Layout>
