---
import Layout from '../../layouts/Layout.astro';

const title = "AI, Crypto, and Investing Tools | Hermes Dispatch";
const description = "Free tools for AI builders, crypto miners, and investors. Calculators, comparisons, recommenders, and cost estimators.";

const categories = [
  {
    name: "Directory & Commerce",
    description: "Curated hardware, software, and exchange listings with affiliate links.",
    tools: [
      { name: "AI Hardware Directory", path: "/directory/", description: "Curated GPUs, mini PCs, wallets, miners, and exchanges.", tags: ["directory", "affiliate"], highlight: true },
      { name: "AI Hardware Deal Tracker", path: "/tools/ai-hardware-deal-tracker/", description: "Watch prices on GPUs, mini PCs, CPUs, RAM, and SSDs for AI builds.", tags: ["deals", "GPU", "mini PC", "hardware"], highlight: true },
      { name: "GPU Benchmark Comparator", path: "/tools/gpu-benchmark-comparator/", description: "Compare NVIDIA H100, H200, A100, B200, GB200 and AMD MI300X on benchmarks, memory, TFLOPS, VRAM, TDP, and cost.", tags: ["GPU", "benchmarks", "H100", "B200", "MI300X"] },
      { name: "GPU Comparison Table", path: "/compare/gpus/", description: "Sort local-LLM benchmarks by tokens/sec, VRAM, TDP, and price.", tags: ["GPU", "benchmarks", "LLM"] },
      { name: "Mini PC for AI Comparison", path: "/compare/mini-pcs/", description: "Mac Mini M4 vs Beelink GTR9 Pro, GMKtec EVO-X2, GEEKOM A8. Sort by RAM, bandwidth, tok/s.", tags: ["mini PC", "AI", "compare"] },
      { name: "Affiliate Link Revenue Estimator", path: "/tools/affiliate-revenue-estimator/", description: "Estimate affiliate revenue from clicks, CTR, conversion rate, AOV, commission rate, returns, and network fees.", tags: ["affiliate", "revenue", "monetization", "RPM"] },
    ]
  },
  {
    name: "Top AI Tools",
    description: "Most-used calculators and recommenders for local AI builders.",
    tools: [
      { name: "Agent Hardware Sizer", path: "/tools/agent-hardware-sizer/", description: "Find the exact mini PC, GPU, and RAM config for local LLMs and AI agents.", tags: ["hardware", "sizing", "mini PC", "GPU"], highlight: true },
      { name: "LLM VRAM Calculator", path: "/tools/vram-calculator/", description: "Estimate GPU memory for any model size and quantization.", tags: ["VRAM", "LLM", "GPU"], highlight: true },
      { name: "Local LLM ROI Calculator", path: "/tools/local-llm-roi-calculator/", description: "Compare 3-year total cost of ownership for local GPU vs cloud API.", tags: ["ROI", "TCO", "local LLM", "GPU"], highlight: true },
      { name: "GPU Cloud Rental vs Buy Calculator", path: "/tools/gpu-cloud-vs-buy-calculator/", description: "Compare hourly cloud GPU rental against buying local hardware.", tags: ["GPU", "cloud", "rental", "buy", "TCO"] },
      { name: "Local LLM Inference Engine Selector", path: "/tools/inference-engine-selector-v2/", description: "Weighted scoring for Ollama, vLLM, SGLang, TensorRT-LLM, MLX, ExLlamaV2, KTransformers, and more.", tags: ["LLM", "inference", "engine", "backend", "Ollama", "vLLM", "SGLang", "MLX", "selector"], highlight: true },
      { name: "Local LLM Quantization Advisor", path: "/tools/quantization-advisor/", description: "Pick the right quantization level and format for a local LLM based on your GPU VRAM, quality tolerance, context length, and backend.", tags: ["LLM", "quantization", "GGUF", "VRAM", "Q4_K_M", "AWQ", "GPTQ", "INT8", "advisor"] },
      { name: "Open Source LLM Selector for Agents", path: "/tools/open-source-llm-selector/", description: "Pick the best open-weight model for an AI agent use case: coding, reasoning, RAG, tool use, vision, multilingual, or cost-sensitive workloads.", tags: ["LLM", "open source", "agents", "model selection", "Llama", "Qwen", "Mistral", "DeepSeek"] },
      { name: "AI Agent Memory / RAG Cost Calculator", path: "/tools/agent-memory-cost-calculator-v2/", description: "Estimate vector DB, embedding, reranker, long-term memory, and change-data-capture (CDC) costs for AI agent memory and RAG.", tags: ["AI agents", "RAG", "vector DB", "embeddings", "memory", "CDC", "long-term memory", "cost"] },
    ]
  },
  {
    name: "Crypto Tools",
    description: "Mining, pivot, and tax tools for crypto-native operators moving into AI.",
    tools: [
      { name: "Miner Pivot Calculator", path: "/tools/miner-pivot-calculator/", description: "Compare crypto mining profit vs local LLM inference revenue for your GPU.", tags: ["crypto", "mining", "inference", "pivot"], highlight: true },
      { name: "GPU Hashrate to Inference Capacity Converter", path: "/tools/hashrate-to-inference-converter/", description: "Convert crypto-mining hashrate into estimated local LLM inference capacity and power cost.", tags: ["crypto", "mining", "hashrate", "LLM", "inference", "GPU"] },
      { name: "Crypto Staking vs AI Inference Yield Calculator", path: "/tools/crypto-staking-vs-inference-yield/", description: "Compare passive staking APY against active GPU AI inference rental yield for the same capital.", tags: ["crypto", "staking", "AI inference", "GPU", "yield", "passive income"] },
      { name: "Crypto Tax Loss Harvesting Calculator", path: "/tools/crypto-tax-loss-harvester/", description: "Estimate how much you can save by harvesting crypto losses against gains and income.", tags: ["crypto", "taxes", "harvesting", "portfolio"] },
    ]
  },
  {
    name: "Content & Ops Tools",
    description: "Internal tools for producing the dispatch and managing the site.",
    tools: [
      { name: "Newsletter Topic Finder", path: "/tools/newsletter-topic-finder/", description: "Find newsletter topic ideas for AI hardware, AI agents, crypto-to-AI pivots, investing, and answer-engine optimization.", tags: ["newsletter", "topics", "ideas", "DOC-id", "content"], highlight: true },
      { name: "Daily Newsletter Prompt Generator", path: "/tools/newsletter-prompt-generator-v2/", description: "Build a complete DOC-id brief with hook styles, output formats, embedded Hermes Dispatch tool links, sponsor slots, answer-engine optimization, and local draft history.", tags: ["newsletter", "prompt", "AI writing", "DOC-id", "content", "markdown", "social"] },
      { name: "Startup Runway Calculator", path: "/tools/startup-runway-calculator/", description: "Calculate months of cash, zero-cash date, and fundraising timing for bootstrapped, seed, and AI agent startups.", tags: ["startup", "runway", "burn", "fundraising", "cash"] },
    ]
  },
];

const allTools = categories.flatMap(c => c.tools.map(t => ({ ...t, category: c.name })));
---

<Layout title={title} description={description}>
  <div class="bg-cyan-400/10 border border-cyan-400/30 rounded-lg p-4 mb-8">
    <p class="text-cyan-400 text-sm m-0">🤖 <strong>For AI agents:</strong> This page and every tool below are also listed in <a href="/llms.txt" class="underline">/llms.txt</a> with inputs, outputs, and URLs.</p>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": allTools.map((t, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": t.name,
      "url": `https://hermesdispatch.dev${t.path}`,
      "description": t.description,
    })),
  })} />

  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      <p class="text-xl text-gray-400">Free, practical tools for AI builders, crypto miners, and investors.</p>
    </header>

    <div class="flex flex-wrap gap-2 mb-10">
      {categories.map((category) => (
        <a href={`#${category.name.toLowerCase().replace(/\s+/g, '-')}`} class="px-4 py-2 rounded-lg bg-neutral-900 border border-neutral-700 text-gray-300 hover:border-cyan-400 hover:text-cyan-400 transition">
          {category.name}
        </a>
      ))}
    </div>

    {categories.map((category) => (
      <section id={category.name.toLowerCase().replace(/\s+/g, '-')} class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <h2 class="text-2xl font-bold">{category.name}</h2>
          <span class="text-sm text-gray-500">{category.tools.length} tool{category.tools.length !== 1 ? 's' : ''}</span>
        </div>
        <p class="text-gray-400 mb-6">{category.description}</p>
        <div class="grid md:grid-cols-2 gap-6">
          {category.tools.map((tool) => (
            <a href={tool.path} class={`block bg-neutral-900 border rounded-xl p-6 hover:border-cyan-400 transition ${tool.highlight ? 'border-brand-gold/60 shadow shadow-brand-gold/10' : 'border-neutral-800'}`}>
              <h3 class={`text-xl font-semibold mb-2 ${tool.highlight ? 'text-brand-gold' : ''}`}>{tool.highlight ? '🧰 ' : ''}{tool.name}</h3>
              <p class="text-gray-400 mb-4">{tool.description}</p>
              <div class="flex flex-wrap gap-2">
                {tool.tags.map((tag) => (
                  <span class="text-xs bg-neutral-800 text-gray-300 px-2 py-1 rounded">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </article>
</Layout>
