---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import data from '../../data/ai_agent_compliance_checker.json';

const title = "AI Agent Privacy / Compliance Checker | Hermes Dispatch";
const description = "Check which privacy, security, and AI regulations apply to your AI agent based on jurisdiction, data types, industry, and features. Get a risk score, framework list, and action checklist.";

const faqs = [
  { q: "Is this a substitute for legal advice?", a: "No. This tool is a directional self-assessment. Laws are interpreted by regulators and courts, and your exact data flows matter. Consult qualified privacy or compliance counsel before making commitments." },
  { q: "Which frameworks does it cover?", a: "GDPR, UK DPA, EU AI Act, CCPA/CPRA, US state privacy laws, HIPAA, FERPA, GLBA, COPPA, PCI DSS, FTC guidance, PIPEDA, LGPD, Singapore PDPA, Japan APPI, South Korea PIPA, India DPDPA, UAE and Saudi PDPL, Australia Privacy Act, SOC 2, ISO 27701, and several national AI governance codes." },
  { q: "What makes an AI agent 'high-risk' under the EU AI Act?", a: "High-risk use cases include biometric identification, credit scoring, employment and education decisions, law-enforcement risk assessments, and certain critical infrastructure. The tool flags automated decisions with significant effects and certain sensitive data types." },
  { q: "Do I need a Data Protection Officer?", a: "GDPR and several other laws require a DPO if your core activities involve large-scale, systematic monitoring of individuals or processing sensitive data on a large scale. The tool lists this as a P1 control when those frameworks apply." },
  { q: "How accurate is the cost estimate?", a: "Costs are directional monthly estimates combining framework program overhead and amortized audit spend. Actual costs depend on team size, lawyer rates, tooling, and whether you already have ISO 27001 or SOC 2 infrastructure." }
];

const fmtMoney = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<Layout title={title} description={description}>
  <ToolSchema name="AI Agent Privacy / Compliance Checker" description={description} url="https://hermesdispatch.dev/tools/ai-agent-compliance-checker/" applicationCategory="DeveloperApplication" operatingSystem="Any" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({"@type": "Question", "name": f.q, "acceptedAnswer": {"@type": "Answer", "text": f.a}}))
  })} />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-gold to-brand-amber mx-auto mb-6 flex items-center justify-center text-3xl shadow-lg shadow-brand-gold/30">🔒</div>
      <h1 class="display-heading mb-4">AI Agent Privacy / Compliance Checker</h1>
      <p class="text-xl text-neutral-400 max-w-2xl mx-auto">Check which privacy, security, and AI regulations apply to your agent. Pick a scenario, select your data and features, and get a risk score, framework list, and action checklist.</p>
    </div>

    <!-- Scenario presets -->
    <section class="glass-card rounded-2xl p-6 mb-8 border border-brand-gold/20">
      <h2 class="text-lg font-bold mb-4 text-brand-gold">Start with a scenario</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4" id="scenario-buttons">
        {data.scenarios.map((s, i) => (
          <button type="button" class="scenario-btn glass-card rounded-xl p-4 text-left hover:border-brand-gold/50 transition-all" data-scenario={i}>
            <h3 class="font-semibold text-white mb-1">{s.name}</h3>
            <p class="text-xs text-neutral-400">{s.description}</p>
          </button>
        ))}
      </div>
    </section>

    <!-- Wizard inputs -->
    <section class="grid lg:grid-cols-2 gap-6 mb-10">
      <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
        <h2 class="text-xl font-bold mb-4 text-brand-gold">1. Where will you operate?</h2>
        <p class="text-sm text-neutral-400 mb-4">Select every jurisdiction where users or their data may be located.</p>
        <div class="space-y-2 max-h-64 overflow-y-auto pr-2">
          {data.jurisdictions.map(j => (
            <label class="flex items-start gap-3 p-2 rounded-lg hover:bg-neutral-800/50 cursor-pointer transition-colors">
              <input type="checkbox" class="jurisdiction-check w-4 h-4 mt-1 accent-brand-gold" value={j.id} />
              <span class="text-sm text-neutral-200">{j.name}</span>
            </label>
          ))}
        </div>

        <h2 class="text-xl font-bold mt-8 mb-4 text-brand-gold">2. What data does the agent touch?</h2>
        <p class="text-sm text-neutral-400 mb-4">Select all data types the agent processes, stores, or embeds.</p>
        <div class="space-y-2 max-h-72 overflow-y-auto pr-2">
          {data.data_types.map(d => (
            <label class="flex items-start gap-3 p-2 rounded-lg hover:bg-neutral-800/50 cursor-pointer transition-colors">
              <input type="checkbox" class="data-type-check w-4 h-4 mt-1 accent-brand-gold" value={d.id} data-risk={d.risk_weight} />
              <span class="text-sm text-neutral-200">{d.name}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
        <h2 class="text-xl font-bold mb-4 text-brand-gold">3. Industry & deployment</h2>
        <label class="block mb-4">
          <span class="text-neutral-400 text-sm">Industry</span>
          <select id="industry" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg px-3 py-2 text-white mt-1">
            {data.industries.map(ind => (
              <option value={ind.id}>{ind.name}</option>
            ))}
          </select>
        </label>
        <label class="block mb-4">
          <span class="text-neutral-400 text-sm">Deployment model</span>
          <select id="deployment" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg px-3 py-2 text-white mt-1">
            {data.deployment_models.map(dm => (
              <option value={dm.id} data-risk={dm.risk_mod}>{dm.name}</option>
            ))}
          </select>
        </label>
        <p id="deploymentNote" class="text-sm text-neutral-400 mb-4">—</p>

        <h2 class="text-xl font-bold mt-6 mb-4 text-brand-gold">4. Agent features</h2>
        <p class="text-sm text-neutral-400 mb-4">Select the capabilities that increase compliance surface area.</p>
        <div class="space-y-2 max-h-80 overflow-y-auto pr-2">
          {data.features.map(f => (
            <label class="flex items-start gap-3 p-2 rounded-lg hover:bg-neutral-800/50 cursor-pointer transition-colors">
              <input type="checkbox" class="feature-check w-4 h-4 mt-1 accent-brand-gold" value={f.id} data-risk={f.risk_weight} />
              <div>
                <span class="text-sm text-neutral-200">{f.name}</span>
                <span class="text-xs text-neutral-500 block">Risk +{f.risk_weight}</span>
              </div>
            </label>
          ))}
        </div>
      </div>
    </section>

    <!-- Results -->
    <section id="results" class="hidden mb-12">
      <div class="grid lg:grid-cols-3 gap-6 mb-8">
        <div class="glass-card rounded-2xl p-6 text-center border border-brand-gold/20">
          <p class="text-xs text-neutral-500 uppercase mb-1">Risk score</p>
          <p id="riskValue" class="text-5xl font-bold text-brand-gold">0%</p>
          <p id="riskLabel" class="text-lg font-medium mt-2">—</p>
        </div>
        <div class="glass-card rounded-2xl p-6 text-center border border-brand-gold/20">
          <p class="text-xs text-neutral-500 uppercase mb-1">Applicable frameworks</p>
          <p id="frameworkCount" class="text-5xl font-bold text-white">0</p>
        </div>
        <div class="glass-card rounded-2xl p-6 text-center border border-brand-gold/20">
          <p class="text-xs text-neutral-500 uppercase mb-1">Est. monthly compliance cost</p>
          <p id="costValue" class="text-4xl font-bold text-brand-gold">—</p>
          <p class="text-xs text-neutral-500 mt-2">Includes amortized annual audit</p>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 mb-8">
        <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
          <h2 class="text-xl font-bold mb-4 text-brand-gold">Applicable frameworks</h2>
          <div id="frameworkList" class="space-y-3 max-h-[600px] overflow-y-auto pr-2"></div>
        </div>
        <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
          <h2 class="text-xl font-bold mb-4 text-brand-gold">Required controls</h2>
          <p class="text-sm text-neutral-400 mb-4">P0 items are launch blockers. P1 items are high priority. Check them off as you implement them.</p>
          <div id="controlsList" class="space-y-2 max-h-[600px] overflow-y-auto pr-2"></div>
        </div>
      </div>

      <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
        <h2 class="text-xl font-bold mb-2 text-brand-gold">Verdict</h2>
        <p id="verdictText" class="text-lg text-neutral-200">—</p>
      </div>
    </section>

    <!-- How it works -->
    <section class="glass-card rounded-2xl p-6 mb-10 border border-brand-gold/20">
      <h2 class="text-xl font-bold mb-4 text-brand-gold">How this checker works</h2>
      <ul class="list-disc pl-5 text-neutral-300 space-y-2">
        <li>Frameworks are triggered by the jurisdictions you serve, the data types you process, and your industry.</li>
        <li>Risk score adds base exposure, data-type risk, feature risk, and deployment-model complexity, then is capped at 100.</li>
        <li>Cost estimate sums monthly framework program overhead and amortizes annual audit/assessment costs over 12 months.</li>
        <li>Controls are filtered to those required by the frameworks that apply to you, plus controls tied to features you selected.</li>
      </ul>
      <p class="text-neutral-500 text-sm mt-6">Last updated: {data.last_updated}. <a href="#note" class="text-cyan-400 underline">See notes</a>.</p>
    </section>

    <!-- FAQ -->
    <section class="glass-card rounded-2xl p-6 mb-12 border border-brand-gold/20">
      <h2 class="text-xl font-bold mb-4 text-brand-gold">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <details class="group bg-neutral-900/50 rounded-xl border border-neutral-800">
            <summary class="p-4 cursor-pointer font-medium text-neutral-200 flex justify-between items-center">{f.q}<span class="text-brand-gold group-open:rotate-180 transition-transform">▼</span></summary>
            <p class="p-4 pt-0 text-neutral-400">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Cross-links -->
    <div class="flex flex-wrap gap-3 mb-8">
      <a href="/tools/agent-pii-detection-cost-calculator/" class="btn-primary text-sm">PII Detection Cost Calc →</a>
      <a href="/tools/agent-deployment-scorecard/" class="px-4 py-2 rounded-lg border border-neutral-700 hover:bg-neutral-800 text-sm transition-colors">Deployment Readiness Scorecard →</a>
      <a href="/tools/agent-redteam-cost-calculator/" class="px-4 py-2 rounded-lg border border-neutral-700 hover:bg-neutral-800 text-sm transition-colors">Red Team Cost Calc →</a>
      <a href="/tools/agent-security-audit-cost-calculator/" class="px-4 py-2 rounded-lg border border-neutral-700 hover:bg-neutral-800 text-sm transition-colors">Security Audit Cost Calc →</a>
    </div>

    <p id="note" class="text-neutral-500 text-sm">{data.note}</p>
  </main>

  <script is:inline define:vars={{ dataJson: JSON.stringify(data), fmtMoneyStr: fmtMoney.format(1234) }}>
    const data = JSON.parse(dataJson);
    const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

    function $q(sel) { return document.querySelectorAll(sel); }
    function $(sel) { return document.querySelector(sel); }
    function getCheckedValues(sel) { return Array.from($q(sel + ':checked')).map(el => el.value); }
    function getSelectedOption(sel) { return $(sel).selectedOptions[0]; }
    function getSelectedValue(sel) { return $(sel).value; }

    function compute() {
      const scenarioIndex = parseInt(document.querySelector('.scenario-btn.active')?.dataset.scenario ?? '0');
      const scenario = data.scenarios[scenarioIndex] || data.scenarios[0];
      const jurisdictions = getCheckedValues('.jurisdiction-check');
      const dataTypes = getCheckedValues('.data-type-check');
      const industryId = getSelectedValue('#industry');
      const deploymentId = getSelectedValue('#deployment');
      const features = getCheckedValues('.feature-check');

      // Build applicable frameworks
      const frameworkIds = new Set();
      jurisdictions.forEach(jid => {
        const j = data.jurisdictions.find(x => x.id === jid);
        if (j) j.frameworks.forEach(f => frameworkIds.add(f));
      });
      dataTypes.forEach(did => {
        const d = data.data_types.find(x => x.id === did);
        if (d) d.frameworks.forEach(f => frameworkIds.add(f));
      });
      const industry = data.industries.find(x => x.id === industryId);
      if (industry) industry.frameworks.forEach(f => frameworkIds.add(f));

      const deployment = data.deployment_models.find(x => x.id === deploymentId);

      // Risk score
      let risk = 10 + scenario.risk_offset;
      dataTypes.forEach(did => {
        const d = data.data_types.find(x => x.id === did);
        risk += (d?.risk_weight || 0);
      });
      features.forEach(fid => {
        const f = data.features.find(x => x.id === fid);
        risk += (f?.risk_weight || 0);
      });
      risk += (deployment?.risk_mod || 0);
      risk = Math.max(0, Math.min(100, risk));

      // Cost estimate
      const applicableFrameworks = data.frameworks.filter(f => frameworkIds.has(f.id));
      let monthly = 0;
      applicableFrameworks.forEach(f => monthly += (f.base_cost_monthly || 0));
      applicableFrameworks.forEach(f => monthly += ((f.audit_cost || 0) / 12));
      // Feature-driven controls rough incremental cost
      features.forEach(fid => {
        const f = data.features.find(x => x.id === fid);
        if (f) monthly += f.risk_weight * 150;
      });

      // Controls
      const featureRequiredControls = new Set();
      features.forEach(fid => {
        const f = data.features.find(x => x.id === fid);
        if (f && f.required_controls) f.required_controls.forEach(c => featureRequiredControls.add(c));
      });
      const applicableControls = data.controls.filter(c => {
        const frameworkMatch = c.frameworks.some(f => frameworkIds.has(f));
        const featureMatch = featureRequiredControls.has(c.id);
        return frameworkMatch || featureMatch;
      }).sort((a, b) => {
        const pa = a.priority === 'P0' ? 0 : 1;
        const pb = b.priority === 'P0' ? 0 : 1;
        return pa - pb || a.text.localeCompare(b.text);
      });

      return { scenario, frameworkIds, risk, monthly, applicableFrameworks, applicableControls, deployment, featureRequiredControls };
    }

    function render() {
      const result = compute();
      const resultsSection = $('#results');
      resultsSection.classList.remove('hidden');

      const riskValue = $('#riskValue');
      const riskLabel = $('#riskLabel');
      riskValue.textContent = result.risk + '%';
      let label = 'Low risk';
      let labelClass = 'text-emerald-400';
      if (result.risk >= 75) { label = 'Critical risk'; labelClass = 'text-red-400'; }
      else if (result.risk >= 55) { label = 'High risk'; labelClass = 'text-amber-400'; }
      else if (result.risk >= 35) { label = 'Medium risk'; labelClass = 'text-yellow-400'; }
      riskLabel.textContent = label;
      riskLabel.className = 'text-lg font-medium mt-2 ' + labelClass;

      $('#frameworkCount').textContent = result.applicableFrameworks.length;
      $('#costValue').textContent = fmt.format(result.monthly);

      const frameworkList = $('#frameworkList');
      if (result.applicableFrameworks.length === 0) {
        frameworkList.innerHTML = '<p class="text-neutral-400 text-sm">No frameworks triggered yet. Select a jurisdiction and data type to see requirements.</p>';
      } else {
        frameworkList.innerHTML = result.applicableFrameworks.map(f => `
          <div class="p-4 rounded-xl bg-neutral-900/50 border border-neutral-800">
            <div class="flex items-center justify-between mb-1">
              <h3 class="font-semibold text-white">${f.name}</h3>
              <span class="text-xs px-2 py-0.5 rounded border ${f.risk_tier === 'critical' ? 'bg-red-500/10 text-red-400 border-red-500/20' : f.risk_tier === 'high' ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' : 'bg-blue-500/10 text-blue-400 border-blue-500/20'}">${f.risk_tier}</span>
            </div>
            <p class="text-xs text-neutral-500 mb-2">${f.full_name}</p>
            <p class="text-sm text-neutral-300">${f.summary}</p>
            <p class="text-xs text-neutral-500 mt-2">Est. ${fmt.format(f.base_cost_monthly || 0)}/mo program + ${fmt.format((f.audit_cost || 0) / 12)}/mo amortized audit</p>
          </div>
        `).join('');
      }

      const controlsList = $('#controlsList');
      if (result.applicableControls.length === 0) {
        controlsList.innerHTML = '<p class="text-neutral-400 text-sm">No controls triggered yet.</p>';
      } else {
        controlsList.innerHTML = result.applicableControls.map(c => `
          <label class="flex items-start gap-3 p-3 rounded-xl bg-neutral-800/50 border border-neutral-700/50 hover:border-brand-gold/30 transition-colors cursor-pointer">
            <input type="checkbox" class="control-check mt-1 w-4 h-4 accent-brand-gold">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs px-2 py-0.5 rounded border ${c.priority === 'P0' ? 'bg-red-500/10 text-red-400 border-red-500/20' : 'bg-blue-500/10 text-blue-400 border-blue-500/20'}">${c.priority}</span>
              </div>
              <p class="text-sm text-neutral-200">${c.text}</p>
            </div>
          </label>
        `).join('');
      }

      const verdict = $('#verdictText');
      if (result.applicableFrameworks.length === 0) {
        verdict.textContent = 'Select at least one jurisdiction and data type to generate a compliance verdict.';
      } else if (result.risk >= 75) {
        verdict.textContent = `Critical exposure: ${result.applicableFrameworks.length} framework(s) apply. Close all P0 controls before launch and engage specialized counsel.`;
      } else if (result.risk >= 55) {
        verdict.textContent = `High exposure: ${result.applicableFrameworks.length} framework(s) apply. Prioritize P0 controls and plan a DPIA or equivalent risk assessment.`;
      } else if (result.risk >= 35) {
        verdict.textContent = `Medium exposure: ${result.applicableFrameworks.length} framework(s) apply. Implement P0 controls and document your lawful basis and data flows.`;
      } else {
        verdict.textContent = `Lower exposure: ${result.applicableFrameworks.length} framework(s) apply. Maintain a privacy policy, DPA, and basic security controls. Re-check as you add features or markets.`;
      }
    }

    function setScenario(index) {
      const scenario = data.scenarios[index];
      document.querySelectorAll('.scenario-btn').forEach((btn, i) => {
        btn.classList.toggle('active', i === index);
        btn.classList.toggle('border-brand-gold', i === index);
        btn.classList.toggle('bg-neutral-800', i === index);
      });
      // Reset checkboxes
      $q('.jurisdiction-check').forEach(el => el.checked = false);
      $q('.data-type-check').forEach(el => el.checked = false);
      $q('.feature-check').forEach(el => el.checked = false);
      // Apply defaults based on scenario
      if (scenario.id === 'b2b') {
        document.querySelector('.jurisdiction-check[value="us"]').checked = true;
        document.querySelector('.jurisdiction-check[value="eu_uk"]').checked = true;
        document.querySelector('.data-type-check[value="pii"]').checked = true;
        document.querySelector('.data-type-check[value="sensitive_pii"]').checked = true;
        document.querySelector('.feature-check[value="rag_memory"]').checked = true;
        document.querySelector('.feature-check[value="third_party_apis"]').checked = true;
        document.querySelector('.feature-check[value="cross_border"]').checked = true;
        $('#industry').value = 'b2b_saas';
        $('#deployment').value = 'saas_multi';
      } else if (scenario.id === 'consumer') {
        document.querySelector('.jurisdiction-check[value="us"]').checked = true;
        document.querySelector('.jurisdiction-check[value="eu_uk"]').checked = true;
        document.querySelector('.data-type-check[value="pii"]').checked = true;
        document.querySelector('.feature-check[value="public_facing"]').checked = true;
        document.querySelector('.feature-check[value="chat_history"]').checked = true;
        document.querySelector('.feature-check[value="logged_outputs"]').checked = true;
        $('#industry').value = 'consumer';
        $('#deployment').value = 'saas_multi';
      } else if (scenario.id === 'high_risk') {
        document.querySelector('.jurisdiction-check[value="us"]').checked = true;
        document.querySelector('.jurisdiction-check[value="eu_uk"]').checked = true;
        document.querySelector('.data-type-check[value="pii"]').checked = true;
        document.querySelector('.data-type-check[value="sensitive_pii"]').checked = true;
        document.querySelector('.data-type-check[value="phi"]').checked = true;
        document.querySelector('.feature-check[value="automated_decisions"]').checked = true;
        document.querySelector('.feature-check[value="pii_extraction"]').checked = true;
        document.querySelector('.feature-check[value="human_review"]').checked = true;
        $('#industry').value = 'healthcare';
        $('#deployment').value = 'saas_multi';
      } else {
        // mvp default
        document.querySelector('.jurisdiction-check[value="us"]').checked = true;
        document.querySelector('.data-type-check[value="pii"]').checked = true;
        document.querySelector('.feature-check[value="chat_history"]').checked = true;
        $('#industry').value = 'b2b_saas';
        $('#deployment').value = 'self_hosted';
      }
      updateDeploymentNote();
      render();
    }

    function updateDeploymentNote() {
      const dm = data.deployment_models.find(x => x.id === $('#deployment').value);
      $('#deploymentNote').textContent = dm ? dm.notes : '—';
    }

    document.querySelectorAll('.scenario-btn').forEach((btn, i) => {
      btn.addEventListener('click', () => setScenario(i));
    });

    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('change', () => { updateDeploymentNote(); render(); });
      if (el.type === 'checkbox') el.addEventListener('click', () => { updateDeploymentNote(); render(); });
    });

    // Initialize with first scenario
    setScenario(0);
  </script>
</Layout>
