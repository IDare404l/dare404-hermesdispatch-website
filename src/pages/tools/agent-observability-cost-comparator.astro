---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import data from '../../data/agent_observability_cost.json';

const title = "AI Agent Observability / APM Cost Comparator | Hermes Dispatch";
const description = "Compare AI agent observability and APM costs across Langfuse, LangSmith, Arize, Laminar, Helicone, Datadog, Braintrust, AgentOps, Honeycomb, and Pydantic Logfire. Estimate monthly, per-trace, and per-span spend with scenario presets.";

const {
  defaults, scenarios, providers, faq
} = data;

const providerMap = Object.fromEntries(providers.map(p => [p.slug, p]));
---

<Layout title={title} description={description}>
  <ToolSchema name="AI Agent Observability / APM Cost Comparator" description={description} url="https://hermesdispatch.dev/tools/agent-observability-cost-comparator/" applicationCategory="DeveloperApplication" operatingSystem="Any" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  })} />

  <section class="relative pt-24 pb-12 overflow-hidden">
    <div class="absolute inset-0 animated-gradient opacity-50"></div>
    <div class="grid-overlay"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-gold to-brand-amber mx-auto mb-6 flex items-center justify-center text-3xl shadow-lg shadow-brand-gold/30">👁️</div>
        <h1 class="display-heading mb-4">AI Agent Observability / APM Cost Comparator</h1>
        <p class="text-xl text-neutral-400 max-w-2xl mx-auto">
          Compare observability and APM costs for AI agents across leading platforms. Model traces, spans, events, seats, retention, sampling, and self-hosting TCO.
        </p>
      </div>

      <!-- Scenarios -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
        {scenarios.map((s, i) => (
          <button type="button" class="scenario-btn glass-card rounded-xl p-4 text-left hover:border-brand-gold/50 transition-all" data-idx={i}>
            <div class="text-2xl mb-2">{s.icon}</div>
            <h3 class="font-semibold text-sm">{s.name}</h3>
            <p class="text-xs text-neutral-400 mt-1">{s.traces_per_month.toLocaleString()} traces/mo • {s.spans_per_trace} spans/trace</p>
          </button>
        ))}
      </div>

      <div class="grid lg:grid-cols-3 gap-6 mb-8">
        <!-- Workload -->
        <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
          <h2 class="text-xl font-bold mb-5 text-brand-gold">Agent workload</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Traces per month</label>
              <input id="tracesPerMonth" type="number" min="0" step="1000" value={defaults.traces_per_month} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm text-neutral-400 mb-1">Spans / trace</label>
                <input id="spansPerTrace" type="number" min="1" step="1" value={defaults.spans_per_trace} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
              </div>
              <div>
                <label class="block text-sm text-neutral-400 mb-1">Events / trace</label>
                <input id="eventsPerTrace" type="number" min="0" step="1" value={defaults.events_per_trace} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
              </div>
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Data size / trace (MB)</label>
              <input id="dataMbPerTrace" type="number" min="0" step="0.01" value={defaults.data_mb_per_trace} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
              <p class="text-xs text-neutral-500 mt-1">Used for data-volume platforms like Laminar.</p>
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Sampling (%)</label>
              <input id="samplingPct" type="number" min="0" max="100" step="1" value={defaults.sampling_pct} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Retention (days)</label>
              <input id="retentionDays" type="number" min="1" step="1" value={defaults.retention_days} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
            </div>
          </div>
        </div>

        <!-- Provider -->
        <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
          <h2 class="text-xl font-bold mb-5 text-brand-gold">Observability platform</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Provider / plan</label>
              <select id="provider" class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white">
                {providers.map(p => <option value={p.slug} selected={p.slug === defaults.provider}>{p.name}</option>)}
              </select>
              <p id="providerNote" class="text-xs text-neutral-500 mt-1">{providerMap[defaults.provider].notes}</p>
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Team seats</label>
              <input id="seats" type="number" min="1" step="1" value={defaults.seats} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
              <p class="text-xs text-neutral-500 mt-1">Only counted for seat-based plans.</p>
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Self-host compute / mo</label>
              <input id="selfHostCompute" type="number" min="0" step="10" value={defaults.self_host_compute_month_usd} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
              <p class="text-xs text-neutral-500 mt-1">Counted only for self-hosted option.</p>
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Engineering hours / week</label>
              <input id="engHoursPerWeek" type="number" min="0" step="0.5" value={defaults.engineering_hours_per_week} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Engineering rate / hour</label>
              <input id="engRate" type="number" min="0" step="5" value={defaults.engineering_rate_hour_usd} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
            </div>
          </div>
        </div>

        <!-- Pricing model -->
        <div class="glass-card rounded-2xl p-6 border border-brand-gold/20">
          <h2 class="text-xl font-bold mb-5 text-brand-gold">Pricing model</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Target gross margin (%)</label>
              <input id="marginPct" type="number" min="0" max="99" step="1" value={defaults.margin_pct} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
            </div>
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Projection period (months)</label>
              <input id="periodMonths" type="number" min="1" max="60" step="1" value={defaults.period_months} class="w-full px-3 py-2 rounded-lg bg-neutral-800 border border-neutral-700 text-white" />
            </div>
            <div class="pt-2">
              <label class="flex items-center gap-3">
                <input id="includeEngineering" type="checkbox" class="w-4 h-4 accent-brand-gold" checked />
                <span class="text-sm text-neutral-300">Include engineering cost</span>
              </label>
            </div>
            <div>
              <label class="flex items-center gap-3">
                <input id="includeSelfHost" type="checkbox" class="w-4 h-4 accent-brand-gold" checked />
                <span class="text-sm text-neutral-300">Include self-host compute</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="grid lg:grid-cols-4 gap-4 mb-8">
        <div class="glass-card rounded-2xl p-5 text-center border border-brand-gold/20">
          <p class="text-xs text-neutral-500 uppercase mb-1">Total monthly cost</p>
          <p id="outTotalMonthly" class="text-3xl font-bold text-brand-gold">—</p>
        </div>
        <div class="glass-card rounded-2xl p-5 text-center border border-brand-gold/20">
          <p class="text-xs text-neutral-500 uppercase mb-1">Cost per 1k traces</p>
          <p id="outCostPer1kTraces" class="text-3xl font-bold text-white">—</p>
        </div>
        <div class="glass-card rounded-2xl p-5 text-center border border-brand-gold/20">
          <p class="text-xs text-neutral-500 uppercase mb-1">Cost per 1k spans</p>
          <p id="outCostPer1kSpans" class="text-3xl font-bold text-emerald-400">—</p>
        </div>
        <div class="glass-card rounded-2xl p-5 text-center border border-brand-gold/20">
          <p class="text-xs text-neutral-500 uppercase mb-1">{defaults.period_months}-month total</p>
          <p id="outPeriodTotal" class="text-3xl font-bold text-brand-gold">—</p>
        </div>
      </div>

      <div class="grid lg:grid-cols-5 gap-4 mb-8">
        <div class="glass-card rounded-2xl p-4 text-center">
          <p class="text-xs text-neutral-500 uppercase mb-1">Platform fee / mo</p>
          <p id="outPlatformFee" class="text-lg font-bold">—</p>
        </div>
        <div class="glass-card rounded-2xl p-4 text-center">
          <p class="text-xs text-neutral-500 uppercase mb-1">Seat cost / mo</p>
          <p id="outSeatCost" class="text-lg font-bold">—</p>
        </div>
        <div class="glass-card rounded-2xl p-4 text-center">
          <p class="text-xs text-neutral-500 uppercase mb-1">Usage overage / mo</p>
          <p id="outOverage" class="text-lg font-bold">—</p>
        </div>
        <div class="glass-card rounded-2xl p-4 text-center">
          <p class="text-xs text-neutral-500 uppercase mb-1">Self-host compute / mo</p>
          <p id="outCompute" class="text-lg font-bold">—</p>
        </div>
        <div class="glass-card rounded-2xl p-4 text-center">
          <p class="text-xs text-neutral-500 uppercase mb-1">Engineering / mo</p>
          <p id="outEngineering" class="text-lg font-bold">—</p>
        </div>
      </div>

      <!-- Pricing to margin -->
      <div class="glass-card rounded-2xl p-6 mb-8 border border-brand-gold/20">
        <h2 class="text-xl font-bold mb-4 text-brand-gold">Pricing to hit margin</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center">
            <p class="text-xs text-neutral-500 uppercase mb-1">Required monthly revenue</p>
            <p id="outRequiredRevenue" class="text-2xl font-bold text-brand-gold">—</p>
          </div>
          <div class="text-center">
            <p class="text-xs text-neutral-500 uppercase mb-1">Price per 1k traces</p>
            <p id="outPricePer1kTraces" class="text-2xl font-bold text-white">—</p>
          </div>
          <div class="text-center">
            <p class="text-xs text-neutral-500 uppercase mb-1">Price per 1k spans</p>
            <p id="outPricePer1kSpans" class="text-2xl font-bold text-emerald-400">—</p>
          </div>
        </div>
      </div>

      <!-- Comparison table -->
      <div class="glass-card rounded-2xl p-6 mb-8 border border-brand-gold/20 overflow-hidden">
        <h2 class="text-xl font-bold mb-4">Cost comparison by provider</h2>
        <p class="text-sm text-neutral-400 mb-4">Same workload across all observability platforms and plans.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm min-w-[900px]">
            <thead class="text-neutral-500 border-b border-neutral-800">
              <tr>
                <th class="text-left py-2">Provider / plan</th>
                <th class="text-right py-2">Base</th>
                <th class="text-right py-2">Seats</th>
                <th class="text-right py-2">Overage</th>
                <th class="text-right py-2">Compute</th>
                <th class="text-right py-2">Eng.</th>
                <th class="text-right py-2 font-semibold text-white">Total/mo</th>
              </tr>
            </thead>
            <tbody id="providerTable" class="divide-y divide-neutral-800">
              {providers.map(p => (
                <tr data-slug={p.slug} class="hover:bg-neutral-800/30">
                  <td class="py-3">
                    <div class="font-medium">{p.name}</div>
                    <div class="text-xs text-neutral-500">{p.notes}</div>
                  </td>
                  <td class="py-3 text-right base-cost">—</td>
                  <td class="py-3 text-right seat-cost">—</td>
                  <td class="py-3 text-right overage-cost">—</td>
                  <td class="py-3 text-right compute-cost">—</td>
                  <td class="py-3 text-right engineering-cost">—</td>
                  <td class="py-3 text-right total-cost font-semibold text-brand-gold">—</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- How it works / When to use -->
      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class="glass-card rounded-2xl p-6">
          <h2 class="text-xl font-bold mb-4 text-brand-gold">How the estimate works</h2>
          <ul class="space-y-2 text-neutral-300 text-sm">
            <li><strong class="text-white">Total monthly units</strong> = traces × (1 + spans/trace + events/trace) × sampling%.</li>
            <li><strong class="text-white">Data volume</strong> = traces × data MB/trace × sampling%; used for Laminar and Arize GB estimates.</li>
            <li><strong class="text-white">Platform cost</strong> = base fee + seat fees + unit overage + data overage.</li>
            <li><strong class="text-white">Self-host compute</strong> = your VM/DB/storage estimate, only counted for self-hosted option.</li>
            <li><strong class="text-white">Engineering</strong> = hours/week × 4.33 weeks × rate. Add more for self-hosted and enterprise rollouts.</li>
            <li><strong class="text-white">Margin pricing</strong> = monthly cost ÷ (1 − margin%).</li>
          </ul>
        </div>
        <div class="glass-card rounded-2xl p-6">
          <h2 class="text-xl font-bold mb-4 text-brand-gold">When to use each category</h2>
          <ul class="space-y-2 text-neutral-300 text-sm">
            <li>• <strong>LangSmith</strong> if you're all-in on LangChain / LangGraph and want Studio.</li>
            <li>• <strong>Langfuse</strong> for open-source, self-host, or seat-free pricing at scale.</li>
            <li>• <strong>Laminar</strong> for agent-first tracing with compression and SQL debugging.</li>
            <li>• <strong>Arize / Braintrust</strong> when evals and regression testing are the priority.</li>
            <li>• <strong>Datadog / Honeycomb</strong> if the team already lives in that APM ecosystem.</li>
            <li>• <strong>Helicone</strong> when you also need gateway, caching, and routing.</li>
          </ul>
        </div>
      </div>

      <section class="glass-card rounded-2xl p-6 mb-10 border border-brand-gold/20">
        <h2 class="text-xl font-bold mb-4 text-brand-gold">Frequently asked questions</h2>
        <div class="space-y-4">
          {faq.map(f => (
            <details class="group bg-neutral-900/50 rounded-xl border border-neutral-800">
              <summary class="p-4 cursor-pointer font-medium text-neutral-200 flex justify-between items-center">{f.question}<span class="text-brand-gold group-open:rotate-180 transition-transform">▼</span></summary>
              <p class="p-4 pt-0 text-neutral-400">{f.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/tools/agent-benchmark-selector/" class="btn-primary text-sm">Agent Benchmark Selector →</a>
        <a href="/tools/mcp-server-cost-estimator/" class="px-4 py-2 rounded-lg border border-neutral-700 hover:bg-neutral-800 text-sm transition-colors">MCP Server Cost Estimator →</a>
        <a href="/tools/llm-cost-calculator/" class="px-4 py-2 rounded-lg border border-neutral-700 hover:bg-neutral-800 text-sm transition-colors">LLM Cost Calculator →</a>
      </div>

      <p class="text-neutral-500 text-sm mt-10">{data.note} Last updated: {data.last_updated}.</p>
    </div>
  </section>

  <script define:vars={{ defaults, scenarios, providers }}>
    const els = {
      tracesPerMonth: document.getElementById('tracesPerMonth'),
      spansPerTrace: document.getElementById('spansPerTrace'),
      eventsPerTrace: document.getElementById('eventsPerTrace'),
      dataMbPerTrace: document.getElementById('dataMbPerTrace'),
      samplingPct: document.getElementById('samplingPct'),
      retentionDays: document.getElementById('retentionDays'),
      provider: document.getElementById('provider'),
      seats: document.getElementById('seats'),
      selfHostCompute: document.getElementById('selfHostCompute'),
      engHoursPerWeek: document.getElementById('engHoursPerWeek'),
      engRate: document.getElementById('engRate'),
      marginPct: document.getElementById('marginPct'),
      periodMonths: document.getElementById('periodMonths'),
      includeEngineering: document.getElementById('includeEngineering'),
      includeSelfHost: document.getElementById('includeSelfHost'),
      providerNote: document.getElementById('providerNote'),
      outTotalMonthly: document.getElementById('outTotalMonthly'),
      outCostPer1kTraces: document.getElementById('outCostPer1kTraces'),
      outCostPer1kSpans: document.getElementById('outCostPer1kSpans'),
      outPeriodTotal: document.getElementById('outPeriodTotal'),
      outPlatformFee: document.getElementById('outPlatformFee'),
      outSeatCost: document.getElementById('outSeatCost'),
      outOverage: document.getElementById('outOverage'),
      outCompute: document.getElementById('outCompute'),
      outEngineering: document.getElementById('outEngineering'),
      outRequiredRevenue: document.getElementById('outRequiredRevenue'),
      outPricePer1kTraces: document.getElementById('outPricePer1kTraces'),
      outPricePer1kSpans: document.getElementById('outPricePer1kSpans'),
    };

    const providerMap = Object.fromEntries(providers.map(p => [p.slug, p]));

    const fmtMoney = (n) => {
      if (n === 0) return '$0';
      if (Math.abs(n) < 0.01) return '$' + n.toFixed(4);
      if (Math.abs(n) < 1) return '$' + n.toFixed(2);
      return '$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 });
    };

    function getInputs() {
      return {
        traces: Math.max(0, parseFloat(els.tracesPerMonth.value) || 0),
        spansPerTrace: Math.max(1, parseFloat(els.spansPerTrace.value) || 1),
        eventsPerTrace: Math.max(0, parseFloat(els.eventsPerTrace.value) || 0),
        dataMbPerTrace: Math.max(0, parseFloat(els.dataMbPerTrace.value) || 0),
        samplingPct: Math.max(0, Math.min(100, parseFloat(els.samplingPct.value) || 0)) / 100,
        retentionDays: Math.max(1, parseInt(els.retentionDays.value, 10) || 1),
        providerSlug: els.provider.value,
        seats: Math.max(1, parseInt(els.seats.value, 10) || 1),
        selfHostCompute: Math.max(0, parseFloat(els.selfHostCompute.value) || 0),
        engHoursPerWeek: Math.max(0, parseFloat(els.engHoursPerWeek.value) || 0),
        engRate: Math.max(0, parseFloat(els.engRate.value) || 0),
        marginPct: Math.max(0, Math.min(99, parseFloat(els.marginPct.value) || 0)) / 100,
        periodMonths: Math.max(1, parseInt(els.periodMonths.value, 10) || 1),
        includeEngineering: els.includeEngineering.checked,
        includeSelfHost: els.includeSelfHost.checked,
      };
    }

    function billableUnits(provider, inputs) {
      const sampledTraces = inputs.traces * inputs.samplingPct;
      const units = sampledTraces * (1 + provider.unit_multiplier_from_spans * inputs.spansPerTrace + inputs.eventsPerTrace);
      const dataGb = sampledTraces * inputs.dataMbPerTrace / 1024;
      return { units, dataGb };
    }

    function computeCost(inputs, providerSlug) {
      const p = providerMap[providerSlug] || providers[0];
      const { units, dataGb } = billableUnits(p, inputs);

      let platformFee = p.base_monthly_usd;
      let seatCost = inputs.seats > p.seats_included ? (inputs.seats - Math.min(p.seats_included, inputs.seats)) * p.per_seat_monthly_usd : 0;
      // Simplification: if per-seat applies to all seats (like LangSmith Plus), use total seats * rate when per_seat_monthly_usd > 0
      if (p.per_seat_monthly_usd > 0) seatCost = inputs.seats * p.per_seat_monthly_usd;

      let overage = 0;
      if (p.unit_name !== 'data_gb') {
        const billable = Math.max(0, units - p.units_included_monthly);
        overage += billable * p.per_unit_usd;
      }
      // Data-volume overage
      const dataOverage = Math.max(0, dataGb - p.data_gb_included) * p.per_gb_usd;
      // For data-volume providers, overage is data-based; units not used.
      if (p.unit_name === 'data_gb') {
        overage = Math.max(0, dataGb - p.units_included_monthly) * p.per_unit_usd;
      } else {
        overage += dataOverage;
      }

      const computeCost = (p.type === 'self-hosted' && inputs.includeSelfHost) ? inputs.selfHostCompute : 0;
      const engineeringCost = inputs.includeEngineering ? inputs.engHoursPerWeek * 4.33 * inputs.engRate : 0;
      const total = platformFee + seatCost + overage + computeCost + engineeringCost;

      const sampledTraces = inputs.traces * inputs.samplingPct;
      const sampledSpans = sampledTraces * inputs.spansPerTrace;
      return {
        platformFee,
        seatCost,
        overage,
        computeCost,
        engineeringCost,
        total,
        costPer1kTraces: sampledTraces > 0 ? (total / sampledTraces) * 1000 : 0,
        costPer1kSpans: sampledSpans > 0 ? (total / sampledSpans) * 1000 : 0,
      };
    }

    function update() {
      const inputs = getInputs();
      const current = computeCost(inputs, inputs.providerSlug);
      const requiredRevenue = inputs.marginPct > 0 ? current.total / (1 - inputs.marginPct) : current.total;

      els.outTotalMonthly.textContent = fmtMoney(current.total);
      els.outCostPer1kTraces.textContent = fmtMoney(current.costPer1kTraces);
      els.outCostPer1kSpans.textContent = fmtMoney(current.costPer1kSpans);
      els.outPeriodTotal.textContent = fmtMoney(current.total * inputs.periodMonths);
      els.outPlatformFee.textContent = fmtMoney(current.platformFee);
      els.outSeatCost.textContent = fmtMoney(current.seatCost);
      els.outOverage.textContent = fmtMoney(current.overage);
      els.outCompute.textContent = fmtMoney(current.computeCost);
      els.outEngineering.textContent = fmtMoney(current.engineeringCost);
      els.outRequiredRevenue.textContent = fmtMoney(requiredRevenue);
      els.outPricePer1kTraces.textContent = fmtMoney(inputs.marginPct > 0 && inputs.traces > 0 ? (requiredRevenue / inputs.traces) * 1000 : 0);
      els.outPricePer1kSpans.textContent = fmtMoney(inputs.marginPct > 0 && inputs.traces * inputs.spansPerTrace > 0 ? (requiredRevenue / (inputs.traces * inputs.spansPerTrace)) * 1000 : 0);

      els.providerNote.textContent = providerMap[inputs.providerSlug].notes;

      document.querySelectorAll('#providerTable tr').forEach(row => {
        const slug = row.dataset.slug;
        const result = computeCost(inputs, slug);
        row.querySelector('.base-cost').textContent = fmtMoney(result.platformFee);
        row.querySelector('.seat-cost').textContent = fmtMoney(result.seatCost);
        row.querySelector('.overage-cost').textContent = fmtMoney(result.overage);
        row.querySelector('.compute-cost').textContent = fmtMoney(result.computeCost);
        row.querySelector('.engineering-cost').textContent = fmtMoney(result.engineeringCost);
        row.querySelector('.total-cost').textContent = fmtMoney(result.total);
        row.classList.toggle('bg-neutral-800/40', slug === inputs.providerSlug);
      });
    }

    function applyScenario(idx) {
      const s = scenarios[idx];
      if (!s) return;
      els.tracesPerMonth.value = s.traces_per_month;
      els.spansPerTrace.value = s.spans_per_trace;
      els.eventsPerTrace.value = s.events_per_trace;
      els.dataMbPerTrace.value = s.data_mb_per_trace;
      els.samplingPct.value = s.sampling_pct;
      els.retentionDays.value = s.retention_days;
      els.provider.value = s.provider;
      els.seats.value = s.seats;
      els.selfHostCompute.value = s.self_host_compute_month_usd;
      els.engHoursPerWeek.value = s.engineering_hours_per_week;
      els.engRate.value = s.engineering_rate_hour_usd;
      els.marginPct.value = s.margin_pct;
      els.periodMonths.value = s.period_months;
      update();
    }

    document.querySelectorAll('.scenario-btn').forEach(btn => {
      btn.addEventListener('click', () => applyScenario(parseInt(btn.dataset.idx, 10)));
    });

    Object.values(els).forEach(el => {
      if (el && (el.tagName === 'INPUT' || el.tagName === 'SELECT')) {
        el.addEventListener('input', update);
      }
    });

    update();
  </script>
</Layout>
