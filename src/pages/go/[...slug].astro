---
// Affiliate / referral redirector with click logging
export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const url = Astro.url.searchParams.get('url') || '';
const source = Astro.url.searchParams.get('source') || 'site';
const slug = Astro.params.slug || Astro.url.pathname.replace(/^\/go\/|\/$/g, '') || 'unknown';

// Only allow http(s) destinations to avoid open redirects
const isSafeUrl = url && (url.startsWith('http://') || url.startsWith('https://'));
const safeUrl = isSafeUrl ? url : '/';

// Log click to KV if available (non-blocking)
try {
  const runtime = (Astro.locals as any)?.runtime;
  const kv = runtime?.env?.CLICKS_KV || runtime?.env?.SUBSCRIBERS_KV;
  if (kv && isSafeUrl) {
    const dateStr = new Date().toISOString().split('T')[0];
    const key = `clicks:${dateStr}:${slug}`;
    const current = await kv.get(key);
    const count = parseInt(current || '0', 10) + 1;
    await kv.put(key, String(count));
    const eventKey = `clicks:${dateStr}:${slug}:events`;
    const eventsRaw = await kv.get(eventKey) || '[]';
    const eventsArr = JSON.parse(eventsRaw);
    eventsArr.push({ slug, source, url: safeUrl, ts: new Date().toISOString() });
    await kv.put(eventKey, JSON.stringify(eventsArr.slice(-100)));
  }
} catch (e) {
  console.error('Click logging error:', e);
}

// Server-side 302 redirect for safe URLs
if (isSafeUrl) {
  return Astro.redirect(safeUrl, 302);
}
---

<Layout
  title="Redirecting..."
  description="You are being redirected to a partner or product page."
  noindex={true}
>
  <section class="relative py-24 overflow-hidden text-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-brand-dark to-brand-accent/10"></div>
    <div class="relative z-10 max-w-md mx-auto px-4">
      <div class="w-16 h-16 rounded-full bg-brand-accent/20 mx-auto mb-6 flex items-center justify-center text-3xl">🔗</div>
      <h1 class="text-2xl font-bold text-white mb-4">Redirecting...</h1>
      <p class="text-gray-400 mb-8">
        If you are not redirected automatically, <a href={safeUrl} class="text-brand-accent hover:underline">click here</a>.
      </p>
      <script is:inline define:vars={{ safeUrl }}>
        window.location.href = safeUrl;
      </script>
    </div>
  </section>
</Layout>
