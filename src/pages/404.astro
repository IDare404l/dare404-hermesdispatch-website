---
import Layout from '../layouts/Layout.astro';

const title = "Page Not Found | HermesDispatch";
const description = "Sorry, we couldn't find that page.";
---

<Layout title={title} description={description}>
  <section class="section-padding text-center">
    <div class="container">
      <div class="text-6xl font-bold text-amber-500 mb-6">404</div>
      <h1 class="text-3xl font-bold mb-4 break-words text-balance">Page Not Found</h1>
      <p class="text-neutral-400 mb-8">Sorry, we couldn't find the page you were looking for.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
        <a href="/" class="btn-primary w-full sm:w-auto justify-center">Back to Home</a>
        <a href="/directory" class="btn-primary w-full sm:w-auto justify-center">Browse Directory</a>
      </div>
      <div class="max-w-md mx-auto rounded-2xl border border-cyan-500/20 bg-cyan-500/5 p-6">
        <h2 class="text-xl font-bold text-white mb-2">Get the AI Hardware &amp; Crypto Directory</h2>
        <p class="text-sm text-neutral-400 mb-4">Daily 4-minute brief. One-click unsubscribe.</p>
        <a href="/subscribe" class="btn-primary inline-block">Subscribe →</a>
      </div>
    </div>
  </section>
</Layout>
